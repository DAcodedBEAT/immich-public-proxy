{
  "name": "immich-public-proxy",
  "version": "3.3.1",
  "description": "Share your Immich photos and albums in a safe way without exposing your Immich instance to the public.",
  "license": "AGPL-3.0",
  "author": "Alan Grainger",
  "repository": {
    "type": "git",
    "url": "https://github.com/alangrainger/immich-public-proxy.git"
  },
  "bin": "dist/index.js",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch src/index.ts\" \"tsc -w -p tsconfig.client.json\"",
    "build": "tsc && tsc -p tsconfig.client.json",
    "build:server": "tsc",
    "build:client": "tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt --write .",
    "analyze": "fallow dead-code",
    "test:container": "podman build --build-arg PACKAGE_VERSION=$(npm pkg get version | xargs) --format docker -t immich-proxy-test .. && podman run --init -it -p=3000:3000 --env-file .env --restart=always immich-proxy-test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.2",
    "archiver": "^7.0.1",
    "cookie-session": "^2.1.0",
    "express": "^4.21.1",
    "form-data": "^4.0.6",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/node": "^22",
    "concurrently": "^10.0.3",
    "fallow": "^3.17.0",
    "jsdom": "^30.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "photoswipe": "^5.4.4",
    "tsx": "^4",
    "typescript": "^5.6.2",
    "vitest": "^4"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
