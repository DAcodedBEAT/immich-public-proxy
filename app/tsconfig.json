{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "Node16",
    "target": "ES2022",
    "allowJs": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "lib": ["DOM", "ES2022"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node", "cookie-session"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/client"],
  "references": [{ "path": "../shared" }]
}
