{
  "name": "immich-public-proxy-workspace",
  "private": true,
  "workspaces": [
    "shared",
    "app",
    "upload-app"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces && vitest run --root docs",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "dev": "npm run dev --workspace=app",
    "bump": "npm version --no-git-tag-version --workspaces"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  }
}
