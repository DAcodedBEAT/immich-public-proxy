{
  "name": "immich-public-proxy-workspace",
  "private": true,
  "workspaces": [
    "shared",
    "app",
    "upload-app"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces && vitest run --root docs",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "analyze": "fallow dead-code",
    "predev": "tsc -b shared",
    "dev": "concurrently -n core,ipp,upload -c magenta,blue,green \"tsc -b -w --preserveWatchOutput shared\" \"npm run dev:app --workspace=app\" \"npm run dev:app --workspace=upload-app\"",
    "bump": "npm version --no-git-tag-version --workspaces"
  },
  "devDependencies": {
    "fallow": "^3.32.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "overrides": {
    "qs": "^6.17.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
